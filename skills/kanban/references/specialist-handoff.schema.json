{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samba/agentic-delta/blob/main/skills/kanban/references/specialist-handoff.schema.json",
  "title": "Agentic Specialist Handoff Interchange Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id", "contract_version", "specialist_class",
    "specialist_class_version", "engagement_role", "worker_id",
    "gate_id", "applicability", "independent", "intent_id", "task_id",
    "run_id", "attempt_id", "scope", "permissions_used", "sources",
    "artifacts_observed", "artifacts_changed", "findings", "evidence",
    "gate_recommendation", "residual_risks", "open_decisions",
    "rework_destination", "status"
  ],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "contract_version": {"const": "2"},
    "specialist_class": {"type": "string", "minLength": 1},
    "specialist_class_version": {"type": "integer", "minimum": 1},
    "engagement_role": {"enum": ["inform", "produce", "review"]},
    "review_purpose": {"enum": ["assurance", "control"]},
    "review_plan_item_id": {"type": "string", "minLength": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": ["string", "null"]},
    "applicability": {"enum": ["applicable", "not-applicable", "undetermined"]},
    "independent": {"type": "boolean"},
    "intent_id": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "attempt_id": {"type": ["string", "integer", "null"]},
    "scope": {"type": "string", "minLength": 1},
    "permissions_used": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "artifacts_observed": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "artifacts_changed": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
    "guidance_proposals": {"type": "array", "items": {"$ref": "#/$defs/guidanceProposal"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "gate_recommendation": {"enum": ["pass", "fail", "blocked", "not-applicable"]},
    "residual_risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "open_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "rework_destination": {"type": ["string", "null"]},
    "status": {"enum": ["complete", "rework", "blocked", "not-applicable", "budget-exhausted", "authorization-required"]}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "publisher", "url"],
      "properties": {
        "reference_id": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": ["string", "null"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref"],
      "properties": {
        "artifact_ref": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "digest": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["severity", "summary"],
      "properties": {
        "severity": {"enum": ["blocker", "required-follow-up", "advisory"]},
        "summary": {"type": "string", "minLength": 1},
        "rework_destination": {"type": ["string", "null"]}
      }
    },
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_id", "tenet_id", "obligation_type", "summary", "lifecycle_stage", "verification_method", "owner"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "tenet_id": {"type": "string", "minLength": 1},
        "obligation_type": {"enum": ["acceptance-criterion", "design-constraint", "decision", "fitness-function", "test", "policy-control", "delivery-safeguard", "observability", "operational-readiness", "risk-disposition"]},
        "summary": {"type": "string", "minLength": 1},
        "affected_artifact": {"type": ["string", "null"]},
        "lifecycle_stage": {"enum": ["Discover", "Design", "Implement", "Verify", "Deliver", "Observe"]},
        "verification_method": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "guidanceProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "guidance_kind", "theme", "title", "statement", "intended_outcome", "rationale", "applicability"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "guidance_kind": {"enum": ["principle", "tenet"]},
        "theme": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "intended_outcome": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "applicability": {"type": "object"},
        "verification_strategy": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "criterion_id", "artifact", "revision", "probe", "result", "producer"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "criterion_id": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "probe": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "inconclusive"]},
        "producer": {"type": "string", "minLength": 1},
        "environment": {"type": ["string", "null"]},
        "location": {"type": ["string", "null"]},
        "content_hash": {"type": ["string", "null"]}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "acceptance_required"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "owner": {"type": ["string", "null"]},
        "acceptance_required": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "authority_required"],
      "properties": {
        "decision_id": {"type": ["string", "null"]},
        "question": {"type": "string", "minLength": 1},
        "authority_required": {"type": "boolean"}
      }
    }
  }
}
